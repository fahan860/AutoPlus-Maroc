POSTGRES_USER=autoplus
POSTGRES_PASSWORD=autoplus
POSTGRES_DB=autoplus
PORT=3000
JWT_SECRET=change-moi-en-production
# Cle de chiffrement des donnees perso (telephone, email) stockees en base.
# Perdre/changer cette cle rend les donnees existantes illisibles : la
# sauvegarder en lieu sur, separement de la base.
PII_ENCRYPTION_KEY=change-moi-en-production
REDIS_URL=redis://localhost:6379
# Code a fournir pour s'inscrire en tant qu'admin (POST /users/register, role=admin).
# Laisser vide desactive completement l'inscription admin.
ADMIN_SIGNUP_CODE=change-moi-en-production

# SMTP pour l'envoi du code de verification email a l'inscription.
# Laisser vide en dev : le code s'affiche alors dans les logs serveur au lieu
# d'etre envoye. Exemple gratuit avec Gmail : creer un "mot de passe
# d'application" (myaccount.google.com/apppasswords) et l'utiliser ci-dessous.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
